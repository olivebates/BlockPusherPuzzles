extends SceneTree
var failures := 0
func _initialize() -> void: call_deferred("run")
func check(value: bool, message: String) -> void:
	print(("PASS: " if value else "FAIL: ")+message)
	if not value: failures += 1
func frames(count: int) -> void:
	for i in count: await physics_frame
func box(parent: Node, point: Vector2, color: int) -> CharacterBody2D:
	var node: CharacterBody2D = load(LevelData.SCENES[2]).instantiate()
	node.block_color = color
	node.position = point
	parent.add_child(node)
	return node
func ball(parent: Node, point: Vector2) -> CharacterBody2D:
	var node: CharacterBody2D = load(LevelData.SCENES[6]).instantiate()
	node.position = point
	parent.add_child(node)
	return node
func wall(parent: Node, point: Vector2) -> StaticBody2D:
	var body := StaticBody2D.new()
	var collider := CollisionShape2D.new()
	var shape := RectangleShape2D.new()
	shape.size = Vector2(16,16)
	collider.shape = shape
	body.add_child(collider)
	body.position = point
	parent.add_child(body)
	return body
func push(body: CharacterBody2D, direction: float) -> void:
	for i in 14:
		body.try_push(direction,1.0/60)
		await frames(1)
	await frames(16)
func run() -> void:
	create_timer(25,true).timeout.connect(func(): quit(99))
	var game: Node2D = load("res://tools/test_world.gd").new().level()
	for child in game.get_node("Objects").get_children(): child.free()
	var player: CharacterBody2D = load(LevelData.SCENES[1]).instantiate()
	player.position = Vector2(56,313)
	game.get_node("Objects").add_child(player)
	root.add_child(game)
	current_scene = game
	var objects := game.get_node("Objects")
	var support_box := box(objects,Vector2(80,312),0)
	var pushed_top := box(objects,Vector2(80,296),1)
	await frames(12)
	player.set_physics_process(false)
	player.position=Vector2(67,298.1)
	check(player.touching_block(1)==pushed_top,"Standing at a box edge selects the top box for a side push, not the floor box")
	check(player.z_index>support_box.z_index,"Player draws above boxes")
	await push(pushed_top,1)
	check(absf(support_box.position.x-80)<0.2 and absf(pushed_top.position.x-96)<0.2,"Pushing the top box leaves its supporting bottom box in place")
	player.position=Vector2(56,313)
	player.set_physics_process(true)
	support_box.free()
	pushed_top.free()
	var chain_a := box(objects,Vector2(200,312),0)
	var chain_b := box(objects,Vector2(216,312),1)
	var chain_c := box(objects,Vector2(232,312),2)
	await frames(12)
	await push(chain_a,1)
	check(absf(chain_a.position.x-216)<0.2 and absf(chain_b.position.x-232)<0.2 and absf(chain_c.position.x-248)<0.2,"Pushing a box carries a chain of touching boxes one tile")
	await push(chain_c,-1)
	check(absf(chain_a.position.x-200)<0.2 and absf(chain_b.position.x-216)<0.2 and absf(chain_c.position.x-232)<0.2,"Box chains can also be pushed left")
	var chain_wall := wall(game,Vector2(248,312))
	await frames(3)
	await push(chain_a,1)
	check(absf(chain_a.position.x-200)<0.2 and absf(chain_c.position.x-232)<0.2,"A wall blocks the entire push chain without separating its boxes")
	chain_wall.free()
	chain_a.free()
	chain_b.free()
	chain_c.free()
	var base := box(objects,Vector2(312,312),0)
	var middle := box(objects,Vector2(312,296),1)
	var top := box(objects,Vector2(312,280),2)
	await frames(12)
	check(SupportCarry.convoy(base).size()==3,"Stack discovery recursively includes every supported box")
	await push(base,1)
	check(absf(base.position.x-328)<0.2 and absf(middle.position.x-328)<0.2 and absf(top.position.x-328)<0.2,"Pushing bottom box carries the full stack exactly one tile")
	check(absf(base.position.y-middle.position.y-16)<0.3 and absf(middle.position.y-top.position.y-16)<0.3,"Box stack keeps its vertical arrangement")
	await push(base,-1)
	check(absf(top.position.x-312)<0.2 and absf(middle.position.x-312)<0.2,"Box stack also travels when pushed left")
	check(base.get_collision_exceptions().is_empty() and top.get_collision_exceptions().is_empty(),"Temporary convoy collision exclusions are restored")
	var blocked_base := box(objects,Vector2(520,312),0)
	var blocked_top := box(objects,Vector2(520,296),1)
	var blocked_tower := box(objects,Vector2(520,280),2)
	wall(game,Vector2(536,296))
	await frames(10)
	await push(blocked_base,1)
	check(absf(blocked_base.position.x-536)<0.2 and absf(blocked_top.position.x-520)<0.2,"Bottom box slides out while an obstructed top box stays in its column")
	check(absf(blocked_tower.position.x-520)<0.2,"Riders above an obstructed box also stay behind")
	check(blocked_base.get_collision_exceptions().is_empty() and blocked_top.get_collision_exceptions().is_empty(),"Detached riders leave no collision exceptions behind")
	var blocked_weld_base := box(objects,Vector2(104,312),0)
	var blocked_weld_left := box(objects,Vector2(104,296),1)
	var blocked_weld_right := box(objects,Vector2(120,296),1)
	wall(game,Vector2(88,296))
	await frames(12)
	await push(blocked_weld_base,-1)
	check(absf(blocked_weld_base.position.x-88)<0.2 and absf(blocked_weld_left.position.x-104)<0.2 and absf(blocked_weld_right.position.x-120)<0.2,"Left push leaves an obstructed welded rider intact")
	var weld_base := box(objects,Vector2(632,312),0)
	var weld_left := box(objects,Vector2(632,296),1)
	var weld_right := box(objects,Vector2(648,296),1)
	var weld_top := box(objects,Vector2(632,280),2)
	await frames(12)
	check(weld_left.leader==weld_right.leader,"Supported same-color pair remains welded")
	await push(weld_base,1)
	check(absf(weld_left.position.x-648)<0.2 and absf(weld_right.position.x-664)<0.2 and absf(weld_top.position.x-648)<0.2,"Carry preserves overhanging welded riders and their own riders")
	var sphere := ball(objects,Vector2(400,240))
	var rider := box(objects,Vector2(400,224),1)
	var rider_top := box(objects,Vector2(400,208),2)
	wall(game,Vector2(488,224))
	await frames(12)
	check(SupportCarry.convoy(sphere).size()==3,"Circle discovers boxes supported on its curved upper surface")
	sphere.touch(Vector2.RIGHT)
	await frames(65)
	check(sphere.position.x>450 and not sphere.sliding,"A rider obstruction stops a sliding circle")
	check(absf(rider.position.x-sphere.position.x)<0.2 and absf(rider_top.position.x-sphere.position.x)<0.2,"Circle carries its entire tower horizontally")
	check(rider.position.x<=472.2,"Carried boxes cannot clip through their obstruction")
	# Register the rider first to verify that scene/physics callback order is irrelevant.
	var vertical_rider := box(objects,Vector2(760,224),1)
	var vertical_ball := ball(objects,Vector2(760,240))
	wall(game,Vector2(760,160))
	await frames(12)
	vertical_ball.touch(Vector2.UP)
	await frames(55)
	check(vertical_ball.position.y<220 and not vertical_ball.sliding,"Upward circle stops when its rider reaches the ceiling")
	check(absf(vertical_ball.position.y-vertical_rider.position.y-16)<0.5,"Vertical circle movement carries an earlier-registered rider")
	var free_ball := ball(objects,Vector2(864,240))
	var free_rider := box(objects,Vector2(864,224),1)
	await frames(10)
	free_ball.touch(Vector2.DOWN)
	await frames(35)
	check(free_ball.position.y>260 and absf(free_ball.position.y-free_rider.position.y-16)<0.5,"Downward circle carries boxes as it descends")
	check(game.background_color.is_equal_approx(HuePalette.DEFAULT_BACKGROUND),"Background retains the game's teal baseline")
	check(game.tile_color.is_equal_approx(HuePalette.DEFAULT_TILES),"Tiles retain the game's dark teal baseline")
	var trigger: Area2D = load(LevelData.SCENES[9]).instantiate()
	trigger.position = Vector2(80,313)
	trigger.hex_color = "#ff5522"
	objects.add_child(trigger)
	await frames(2)
	check(not trigger.visible and trigger.monitoring,"Color trigger is invisible in game but continues detecting touches")
	player.position = trigger.position
	await frames(30)
	check(game.background_color.is_equal_approx(HuePalette.DEFAULT_BACKGROUND) and game.tile_color.is_equal_approx(HuePalette.DEFAULT_TILES) and is_equal_approx(game.hue_shift,HuePalette.hue_offset(trigger.selected_color())),"Invisible color trigger changes the palette while preserving base colors")
	await frames(30)
	current_scene = null
	game.queue_free()
	await process_frame
	print("STACKS: ","PASS" if failures==0 else "FAIL (%d)" % failures)
	quit(failures)
