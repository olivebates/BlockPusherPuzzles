extends SceneTree
var failures := 0
var game: Node2D
var objects: Node2D
func _initialize() -> void: call_deferred("run")
func check(value: bool, message: String) -> void:
	print(("PASS: " if value else "FAIL: ")+message)
	if not value: failures+=1
func frames(count: int) -> void:
	for i in count: await physics_frame
func group(points: Array[Vector2]) -> CharacterBody2D:
	var leader: CharacterBody2D
	for point in points:
		var node: CharacterBody2D=load(LevelData.SCENES[2]).instantiate()
		node.position=point
		node.block_color=3
		objects.add_child(node)
		node.set_physics_process(false)
		if not leader: leader=node
	return leader
func rotator(cw := true) -> Node2D:
	var node: Node2D=load(LevelData.SCENES[10 if cw else 11]).instantiate()
	node.position=Vector2(-1000,-1000)
	objects.add_child(node)
	return node
func erase_group(body: CharacterBody2D) -> void:
	for member in body.members.duplicate(): member.free()
func run() -> void:
	create_timer(30,true).timeout.connect(func(): quit(99))
	game=load("res://tools/test_world.gd").new().level()
	root.add_child(game)
	current_scene=game
	objects=game.get_node("Objects")
	await frames(10)
	var player: CharacterBody2D=get_first_node_in_group("player")
	player.set_physics_process(false)
	player.position=Vector2(56,313)
	var block := group([Vector2(744,160),Vector2(760,160),Vector2(776,160)])
	await frames(3)
	var cw := rotator()
	check(cw.center_member(block)==block.members[1],"Welded rotation pivots on the center-most member")
	check(block.rotation_pivot_member()==cw.center_member(block),"Visible pivot and rotator use the same center-most member")
	check(cw.activate(block) and block.rotating,"Clockwise rotator starts an animated quarter turn")
	await frames(5)
	check(block.rotating and absf(block.rotation)>0.01 and absf(block.rotation)<PI/2,"Rotation and translation interpolate during the 0.2 second turn")
	await frames(13)
	check(not block.rotating and block.position.distance_to(Vector2(760,144))<0.2 and block.members[2].position.distance_to(Vector2(760,176))<0.2,"Clockwise turn finishes exactly on grid around its pivot")
	check(cw.cooldown==3 and absf(cw.countdown-3)<0.01,"A completed rotation starts a three-push cooldown")
	root.get_node("Juice").block_pushed.emit()
	await frames(5)
	check(cw.cooldown==2 and cw.countdown>2 and cw.countdown<3,"Each push smoothly animates the circular countdown")
	await frames(12)
	root.get_node("Juice").block_pushed.emit()
	root.get_node("Juice").block_pushed.emit()
	await frames(16)
	check(cw.cooldown==0 and cw.countdown<0.01,"Exactly three subsequent pushes reactivate a rotator")
	cw.cooldown=3
	cw.countdown=3
	check(block.members[2].reset_home() and block.position.distance_to(Vector2(744,160))<0.2 and block.members[2].weld_offset==Vector2(32,0),"Recall restores both the original position and welded orientation")
	check(cw.cooldown==2,"A manual welded-box recall counts as exactly one rotator turn")
	block.reset_home(true)
	check(cw.cooldown==2,"Automatic recalls do not consume rotator cooldown turns")
	var home_obstruction := StaticBody2D.new()
	var home_shape := CollisionShape2D.new()
	var home_rect := RectangleShape2D.new()
	home_rect.size=Vector2(16,16)
	home_shape.shape=home_rect
	home_obstruction.add_child(home_shape)
	home_obstruction.position=block.home
	block.position.x+=64
	block.sync_members()
	game.add_child(home_obstruction)
	await frames(2)
	check(not block.reset_home() and cw.cooldown==2,"A rejected recall does not consume a rotator cooldown turn")
	home_obstruction.free()
	erase_group(block)
	block=group([Vector2(744,160),Vector2(760,160),Vector2(776,160)])
	await frames(3)
	var ccw := rotator(false)
	check(ccw.activate(block),"Counterclockwise scene turns in the opposite direction")
	await frames(18)
	check(block.position.distance_to(Vector2(760,176))<0.2 and block.members[2].position.distance_to(Vector2(760,144))<0.2,"Counterclockwise quarter turn has the expected opposite geometry")
	erase_group(block)
	block=group([Vector2(744,312),Vector2(760,312),Vector2(776,312)])
	await frames(3)
	var ground := rotator()
	check(ground.activate(block),"Rotation against the floor finds a raised position")
	await frames(18)
	check(absf(block.position.y-280)<0.2 and absf(block.members[2].position.y-312)<0.2,"Ground correction lifts the rotated weld in whole tiles")
	erase_group(block)
	block=group([Vector2(744,128),Vector2(744,144),Vector2(744,160)])
	await frames(3)
	var walls: TileMapLayer=game.get_node("Walls")
	walls.set_cell(Vector2i(47,8),0,Vector2i.ZERO)
	walls.set_cell(Vector2i(47,9),0,Vector2i.ZERO)
	await frames(2)
	var wall := rotator()
	check(wall.activate(block),"Side-wall collision shifts the rotated shape toward its pivot center")
	await frames(18)
	check(block.position.x<752 and absf(block.members[2].position.x-block.position.x+32)<0.2,"Wall correction preserves the rotated welded shape")
	erase_group(block)
	walls.erase_cell(Vector2i(47,8))
	walls.erase_cell(Vector2i(47,9))
	block=group([Vector2(744,312),Vector2(760,312),Vector2(776,312)])
	await frames(3)
	walls.set_cell(Vector2i(47,17),0,Vector2i.ZERO)
	await frames(2)
	var ceiling := rotator()
	check(not ceiling.activate(block) and ceiling.failure_flash>0 and not block.rotating,"A floor correction into a ceiling rejects the turn and flashes a red X")
	check(block.position==Vector2(744,312) and ceiling.cooldown==0,"Rejected turns preserve the original shape and consume no cooldown")
	erase_group(block)
	walls.erase_cell(Vector2i(47,17))
	block=group([Vector2(744,160),Vector2(760,160),Vector2(776,160)])
	await frames(3)
	player.position=Vector2(760,176)
	walls.set_cell(Vector2i(46,11),0,Vector2i.ZERO)
	walls.set_cell(Vector2i(48,11),0,Vector2i.ZERO)
	await frames(2)
	var wait := rotator()
	check(wait.activate(block) and wait.waiting,"A rotation onto the player waits instead of displacing them")
	await frames(20)
	check(block.position==Vector2(744,160) and block.rotating and wait.cooldown==0,"A waiting turn keeps the box still until the player has room")
	walls.erase_cell(Vector2i(46,11))
	walls.erase_cell(Vector2i(48,11))
	player.position=Vector2(56,313)
	await frames(18)
	check(not block.rotating and wait.cooldown==3,"The waiting rotation completes once the player moves clear")
	var saved := LevelData.decode(LevelData.encode(LevelData.capture(game)))
	var kinds: Array=[]
	for item in saved.objects:
		if int(item[0]) in [10,11]: kinds.append(int(item[0]))
	check(kinds.has(10) and kinds.has(11),"Both rotator directions survive compressed level save/load")
	var offsets: Array[Vector2]=[Vector2.ZERO,Vector2(16,0),Vector2(0,16)]
	var loops := WeldOutline.contours(offsets)
	check(loops.size()==1 and loops[0][0]==loops[0][-1] and loops[0].has(Vector2(7.5,7.5)),"L-shaped welds have a continuous closed outline through their inner corner")
	cw.cooldown=3
	cw.countdown=3
	var pushed: CharacterBody2D=objects.get_node("Block_0")
	for turn in 3:
		for i in 14:
			pushed.try_push(1,1.0/60)
			await frames(1)
		await frames(15)
	check(absf(pushed.position.x-168)<0.2 and cw.cooldown==0,"Three real completed tile pushes recharge the rotator")
	cw.cooldown=2
	cw.countdown=2
	# The neighboring welded boxes are now pushable as a chain. A wall
	# beyond them is needed to make this a genuinely blocked push.
	var stop := StaticBody2D.new()
	var stop_shape := CollisionShape2D.new()
	var stop_rect := RectangleShape2D.new()
	stop_rect.size=Vector2(16,16)
	stop_shape.shape=stop_rect
	stop.add_child(stop_shape)
	stop.position=Vector2(216,312)
	game.add_child(stop)
	await frames(2)
	for i in 14:
		pushed.try_push(1,1.0/60)
		await frames(1)
	await frames(15)
	check(cw.cooldown==2,"A blocked push consumes no rotator countdown turn")
	var escape := group([Vector2(840,160),Vector2(856,160),Vector2(872,160)])
	await frames(3)
	player.position=Vector2(856,136)
	var lifting := rotator()
	check(lifting.activate(escape) and player.position==Vector2(856,120),"Rotation overlap moves the player exactly one tile up when it is clear")
	player.set_physics_process(true)
	Input.action_press("right")
	Input.action_press("jump")
	await frames(5)
	check(player.position==Vector2(856,120) and player.velocity==Vector2.ZERO and not player.rotation_locks.is_empty(),"Player movement, jumping, and gravity freeze during rotation")
	Input.action_release("right")
	Input.action_release("jump")
	await frames(14)
	check(player.rotation_locks.is_empty(),"Player controls unfreeze when the rotation finishes")
	player.set_physics_process(false)
	erase_group(escape)
	escape=group([Vector2(840,160),Vector2(856,160),Vector2(872,160)])
	await frames(3)
	player.position=Vector2(856,176)
	var left_escape := rotator()
	check(left_escape.activate(escape) and player.position==Vector2(840,176),"A blocked upward exit uses the free tile on the left")
	await frames(18)
	erase_group(escape)
	escape=group([Vector2(840,160),Vector2(856,160),Vector2(872,160)])
	await frames(3)
	walls.set_cell(Vector2i(52,11),0,Vector2i.ZERO)
	await frames(2)
	player.position=Vector2(856,176)
	var right_escape := rotator()
	check(right_escape.activate(escape) and player.position==Vector2(872,176),"If up and left are blocked the player moves exactly one tile right")
	right_escape.cancel()
	check(player.rotation_locks.is_empty() and not escape.rotating,"Cancelling a rotation releases the player's freeze")
	walls.erase_cell(Vector2i(52,11))
	erase_group(escape)
	player.position=Vector2(56,313)
	var falling := group([Vector2(856,120)])
	await frames(3)
	var airborne := rotator()
	airborne.position=Vector2(856,144)
	falling.set_physics_process(true)
	await frames(10)
	check(falling.rotating or airborne.cooldown==3,"Touching a rotator while falling also triggers its turn")
	current_scene=null
	game.queue_free()
	await process_frame
	print("ROTATORS: ","PASS" if failures==0 else "FAIL")
	quit(failures)
